{
  "name": "stock-market-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "A moddable desktop stock-market simulation game.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "vite build",
    "build:win": "vite build && electron-builder --win dir && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^7.2.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.sakurefa.stockmarketsimulator",
    "productName": "Market Simulator",
    "directories": { "output": "release" },
    "artifactName": "Market-Simulator-${version}-Windows-${arch}.${ext}",
    "files": [
      "package.json",
      "electron/main.cjs",
      "electron/preload.cjs",
      "dist/**/*"
    ],
    "extraFiles": [
      { "from": "mods", "to": "mods" },
      { "from": "src", "to": "source/src" },
      { "from": "electron", "to": "source/electron" },
      { "from": "data", "to": "source/data" },
      { "from": "index.html", "to": "source/index.html" },
      { "from": "vite.config.js", "to": "source/vite.config.js" },
      { "from": "package.json", "to": "source/package.json" },
      { "from": "README.md", "to": "README.md" },
      { "from": "MOD_API.md", "to": "MOD_API.md" }
    ],
    "asar": true,
    "win": {
      "target": [{ "target": "dir", "arch": ["x64"] }]
    }
  }
}