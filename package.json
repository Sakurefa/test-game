{
  "name": "stock-market-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "A moddable desktop stock-market simulation game.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "vite build",
    "build:win": "vite build && electron-builder --win portable",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^7.2.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.sakurefa.stockmarketsimulator",
    "productName": "Stock Market Simulator",
    "directories": {
      "output": "release"
    },
    "artifactName": "Market-Simulator-${version}-Windows-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
